[Unit]
Description=Run all mbsync account syncs in parallel
After=network.target network-online.target
Wants=network-online.target
StartLimitBurst=2

[Service]
# one mbsync process per channel, all in parallel (mbsync locks each
# mailbox, so concurrent runs are safe); the channel list comes from
# ~/.mbsyncrc, no account names to maintain here
ExecStart=/bin/sh -c 'for c in $(sed -n "s/^Channel //p" ~/.mbsyncrc); do /usr/bin/mbsync "$c" & done; wait'
RuntimeMaxSec=5m
Restart=on-failure

[Install]
WantedBy=timers.target
