# Maintainer: Reza Jelveh <reza.jelveh+git@gmail.com>
#
# @PKGVER@ substituted by the release workflow; the git source pins the
# tagged commit (sha256sums=SKIP is AUR-legal for VCS sources).
pkgname=notmutt-cli
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Async terminal email client built on notmuch (CLI backend, Apache-clean)'
arch=('x86_64')
url='https://github.com/fishman/notmutt'
license=('Apache-2.0')
depends=('notmuch')
makedepends=('go')
source=("notmutt::git+https://github.com/fishman/notmutt.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
    cd "$srcdir/notmutt/src"
    go build -tags "lua cli" -o ../notmutt-cli .
}

package() {
    cd "$srcdir/notmutt"
    install -Dm755 notmutt-cli "$pkgdir/usr/bin/notmutt-cli"
    install -Dm644 README.md "$pkgdir/usr/share/doc/notmutt-cli/README.md"
}
